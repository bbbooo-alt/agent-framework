# ==========================================
# LLM API 密钥配置
# 只需配置你使用的厂商的 API Key 即可
# 模型和地址已内置在代码中
# ==========================================

# LongCat API Key（默认厂商）
LONGCAT_API_KEY=ak_21Y92l18v6Ct7es4Ss6y89xL4JW6y

# 其他厂商（按需取消注释并填写）
# OPENAI_API_KEY=your_openai_api_key
# MODELSCOPE_API_KEY=your_modelscope_api_key
# DASHSCOPE_API_KEY=your_dashscope_api_key
# DEEPSEEK_API_KEY=your_deepseek_api_key

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# ==========================================
# 本地 Ollama 配置
# ==========================================
# 使用本地 Ollama 时，只需设置以下环境变量
# 无需 API Key，模型和地址已内置
OLLAMA_API_KEY=ollama
